<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Car Shopping — Cost of Ownership</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/">Watchlist</a>
    <a href="/listings">All Listings</a>
    <a href="/depreciation">Depreciation</a>
    <a href="/alternatives">Alternatives</a>
    <a href="/cost">Cost of Ownership</a>
  </nav>
  <main>
    <h1>Estimated Cost of Ownership</h1>
    <p class="muted">Monthly cost estimate per vehicle — depreciation + fuel.</p>
    <% if (data.length === 0) { %>
      <p class="muted">No data yet — run a scrape pass to populate depreciation estimates.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Make</th>
            <th>Model</th>
            <th>Depr. Rate</th>
            <th>Depreciation $/mo</th>
            <th>Fuel $/mo</th>
            <th>Total $/mo</th>
            <th>MPG / MPGe</th>
            <th>Monthly Miles</th>
            <th>Gas Price</th>
          </tr>
        </thead>
        <tbody>
          <% data.forEach(d => { %>
            <tr>
              <td><%= d.make %></td>
              <td><%= d.model %></td>
              <td><%= d.depreciation_rate_pct != null ? d.depreciation_rate_pct + '%/yr' : '—' %></td>
              <td><%= d.depreciation_per_month != null ? '$' + Math.round(d.depreciation_per_month).toLocaleString() : '—' %></td>
              <td><%= d.fuel_per_month != null ? '$' + Math.round(d.fuel_per_month).toLocaleString() : '—' %></td>
              <td><strong><%= d.total_per_month != null ? '$' + Math.round(d.total_per_month).toLocaleString() : '—' %></strong></td>
              <td><%= d.mpg_used != null ? d.mpg_used : '—' %></td>
              <td><%= d.monthly_miles.toLocaleString() %></td>
              <td>$<%= d.gas_price.toFixed(2) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <p class="muted" style="margin-top:1rem; font-size:0.85em;">
        Depreciation uses V(t) = V₀·(1−r)^t fitted to cross-sectional iSeeCars
        market prices. Monthly figure = current median listing price × r ÷ 12.
        Fuel uses EPA combined MPG/MPGe; PHEVs use blended efficiency
        (electricity normalized to gas-equivalent gallon).
      </p>
    <% } %>
  </main>
</body>
</html>
